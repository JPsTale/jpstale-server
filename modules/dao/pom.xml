<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.jpstale.server</groupId>
        <artifactId>modules</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>dao</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!--
          数据源栈由本模块持有（原 pt-dao-spring-boot-starter 的职责整份搬到这里）：
          dynamic-datasource 才是 DataSource 的实际提供者（两个 app 的 application.yml 都有
          spring.datasource.dynamic.*）。挂在 dao 而不是让两个 app 各抄一遍 —— 任何依赖 dao 的
          消费者零知识成本，且不会出现"一边有、一边没有"。PtDaoAutoConfiguration
          （@MapperScan("org.jpstale.dao")）也随之下沉到本模块，仍走 AutoConfiguration 机制，
          故与拆分 starter 之前**行为完全一致**。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 编译 @AutoConfiguration 需要；显式声明，不靠传递（pt-server-core 的教训） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 代码生成（仅 test 下运行 DaoCodeGenerator 需要） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
            <version>3.5.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- DaoCodeGenerator 仅手动执行，不绑定任何生命周期阶段：mvn exec:java 时再运行 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>org.jpstale.dao.generator.DaoCodeGenerator</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
                <!-- 不配置 executions，避免在 test-compile/test 等阶段自动执行 -->
            </plugin>
        </plugins>
    </build>
</project>
