<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jpstale.server</groupId>
        <artifactId>tools</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pt-visualizer</artifactId>
    <packaging>jar</packaging>

    <name>pt-visualizer</name>
    <description>jME3 wireframe viewer: load all 44 field .smd collision meshes and render in one scene</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jme3.version>3.9.0-stable</jme3.version>
    </properties>

    <dependencies>
        <!--
          只需要地图/资产库（SmdMapLoader/SmdMapData/CollisionMesh/MapMesh/FieldCatalog/FieldInfo）
          → 依赖 common-service，**不再依赖 game-server**。
          为什么必须断掉这条边：game-server 是应用，`spring-boot-maven-plugin:repackage` 会把它的
          主产物换成可执行胖 jar（类在 BOOT-INF/classes 下），于是"工具依赖应用"在 `mvn package/install`
          阶段必然编译失败 —— 它过去能跑只是因为 IDE/reactor 直接用了 target/classes。
        -->
        <dependency>
            <groupId>org.jpstale.server</groupId>
            <artifactId>common-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- jME3：桌面窗口渲染所需的三个核心 artifact（lwjgl native 由 jme3-lwjgl3 传递带入） -->
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-core</artifactId>
            <version>${jme3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-desktop</artifactId>
            <version>${jme3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-lwjgl3</artifactId>
            <version>${jme3.version}</version>
        </dependency>

        <!-- PostgreSQL：加载 mapspawnpoint 刷怪点 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.10</version>
        </dependency>
    </dependencies>
</project>
